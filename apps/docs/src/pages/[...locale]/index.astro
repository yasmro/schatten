---
// Landing skeleton (#449 Phase 2). The page itself is the dogfood: no React,
// no Tailwind — only `.st-*` classes and semantic tokens from the published
// CSS surface, consumed through the exports map (workspace:* → repo root
// dist/). The only JavaScript is the theme plumbing below (the library's
// published FOUC snippet + a framework-free toggle), which dogfoods the
// non-React consumption path of `@yasmro/schatten/theme-init`.
//
// i18n: rest-param route — `/` renders the default locale (ja), `/en/` the
// English variant. Copy lives in src/i18n/ui.ts; this template is shared.
import '@yasmro/schatten/schatten.css'
import { THEME_INIT_SCRIPT } from '@yasmro/schatten/theme-init'
import GoogleFonts from '../../components/GoogleFonts.astro'
import { defaultLocale, type Locale, localePath, locales, ui } from '../../i18n/ui'

// Theme scripts — both consume the library's PUBLIC runtime contract
// (localStorage key `schatten-theme`, JSON shape `{ mode, special }`,
// api-stability.md §Provider runtime contract). No React on this page, so:
//
// 1. THEME_INIT_SCRIPT — the published FOUC snippet, inlined verbatim from
//    `@yasmro/schatten/theme-init` (dogfood of the non-React consumption
//    path). It applies `.dark` before first paint.
// 2. A `.light` supplement — the dist guards its OS-dark media block with
//    `:root:not(.light)`, so an explicit light choice under a dark OS needs
//    the `.light` class. The snippet doesn't set it (ThemeProvider handles
//    this differently); a vanilla consumer adds it from the same stored mode.
// 3. The toggle handler — resolves the *effective* mode (class or OS), flips
//    it, and persists `mode` while preserving any stored `special`.
const THEME_LIGHT_SUPPLEMENT = `(function(){try{var s=localStorage.getItem('schatten-theme');var t=s?JSON.parse(s):{};if(t.mode==='light')document.documentElement.classList.add('light')}catch(e){}})();`

const THEME_TOGGLE_SCRIPT = `(function(){var KEY='schatten-theme';var root=document.documentElement;document.addEventListener('click',function(e){var b=e.target.closest('[data-theme-toggle]');if(!b)return;var dark=root.classList.contains('dark')||(!root.classList.contains('light')&&matchMedia('(prefers-color-scheme: dark)').matches);var next=dark?'light':'dark';root.classList.toggle('dark',next==='dark');root.classList.toggle('light',next==='light');var t={};try{t=JSON.parse(localStorage.getItem(KEY))||{}}catch(err){}t.mode=next;try{localStorage.setItem(KEY,JSON.stringify(t))}catch(err){}});})();`

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale]
const otherLocale: Locale = locale === 'ja' ? 'en' : 'ja'

// Seasonal swatches: the 500 rung of each Special in
// src/themes/seasonal/themes.css — every season shares one lightness ladder
// (L 64% at 500) and moves only hue/chroma. Hand-copied for the skeleton;
// Phase 3 should generate this strip from the tokens (SSOT → consumer map row).
const seasonSwatches = [
  'oklch(64% 0.1 12)',
  'oklch(64% 0.1 138)',
  'oklch(64% 0.09 162)',
  'oklch(64% 0.11 45)',
  'oklch(64% 0.085 230)',
  'oklch(64% 0.1 70)',
  'oklch(64% 0.048 250)',
  'oklch(64% 0.08 255)',
]
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Schatten — design system</title>
    <meta name="description" content={t.metaDescription} />
    {/* hreflang は本来絶対 URL。デプロイ先が決まり astro.config に `site` を
        設定したら `new URL(localePath(l), Astro.site)` に差し替えること。 */}
    {locales.map((l) => <link rel="alternate" hreflang={l} href={localePath(l)} />)}
    <script is:inline set:html={THEME_INIT_SCRIPT + THEME_LIGHT_SUPPLEMENT} />
    <GoogleFonts serif />
  </head>
  <body>
    <header class="site-header">
      <span class="site-header__brand">Schatten</span>
      <nav class="site-header__nav">
        <a href="https://github.com/yasmro/schatten">GitHub</a>
        <a href="https://yasmro.github.io/schatten/">Storybook</a>
        <a href={localePath(otherLocale)} class="site-header__lang" lang={otherLocale}>
          {t.langSwitchLabel}
        </a>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label={t.themeToggleLabel}
          title={t.themeToggleLabel}
        >
          <svg
            class="theme-toggle__icon theme-toggle__icon--moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="theme-toggle__icon theme-toggle__icon--sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
        </button>
      </nav>
    </header>

    <main class="page">
      <section class="hero">
        <h1 class="hero__title">{t.heroTitle}</h1>
        <p class="hero__lead" set:html={t.heroLead} />

        <div class="hero__actions">
          {/* 暫定リンク: サイト内 getting-started ページ(#449 Phase 3)が
              立つまで README へ飛ばす。Phase 3 で差し替えること。 */}
          <a
            href="https://github.com/yasmro/schatten#getting-started"
            class="st-btn st-btn--primary st-btn--lg"
          >
            {t.ctaGetStarted}
          </a>
          <a
            href="https://yasmro.github.io/schatten/"
            class="st-btn st-btn--secondary st-btn--lg"
          >
            {t.ctaStorybook}
          </a>
        </div>

        <div class="hero__badges">
          <span class="st-badge st-badge--neutral st-badge--solid st-badge--md">v1.0.0</span>
          <span class="st-badge st-badge--success st-badge--subtle st-badge--md">API stable</span>
          <span class="st-badge st-badge--info st-badge--outline st-badge--md">ESM only</span>
        </div>
      </section>

      <!-- Proof block: the two delivery layers, side by side, one render. -->
      <section class="proof">
        <div class="st-card st-card--filled proof__card">
          <div class="st-card__header">
            <div class="st-card__title">{t.proofTitle}</div>
            <div class="st-card__description">{t.proofDesc}</div>
          </div>
          <div class="st-card__content proof__content">
            <figure class="proof__pane">
              <figcaption class="proof__caption">React</figcaption>
              <pre
                class="proof__code"><code>&lt;Button variant="primary"
  size="md"&gt;
  {t.proofRenderButton}
&lt;/Button&gt;</code></pre>
            </figure>
            <figure class="proof__pane">
              <figcaption class="proof__caption">Vanilla HTML</figcaption>
              <pre
                class="proof__code"><code>&lt;button class="st-btn
  st-btn--primary st-btn--md"&gt;
  {t.proofRenderButton}
&lt;/button&gt;</code></pre>
            </figure>
            <div class="proof__render">
              <span class="proof__caption">{t.proofRenderLabel}</span>
              <button type="button" class="st-btn st-btn--primary st-btn--md">
                {t.proofRenderButton}
              </button>
            </div>
          </div>
          <div class="st-card__footer proof__footer" set:html={t.proofFooter} />
        </div>
      </section>

      <!-- Seasonal strip: the Mode × Special demo only a self-hosted site can
           run. Swatch values are defined in the frontmatter above. -->
      <section class="seasons">
        <h2 class="seasons__title">{t.seasonsTitle}</h2>
        <p class="seasons__lead" set:html={t.seasonsLead} />
        <ul class="seasons__strip">
          {
            seasonSwatches.map((swatch, i) => (
              <li class="seasons__swatch" style={`--swatch: ${swatch}`}>
                <span>{t.seasonNames[i]}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="callout-demo">
        <div class="st-callout st-callout--info st-callout--subtle" role="note">
          <div class="st-callout__body" set:html={t.calloutNote} />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© yasmro — MIT License</span>
    </footer>
    <script is:inline set:html={THEME_TOGGLE_SCRIPT} />
  </body>
</html>

<style>
  /* Site-local layout only. Colors / spacing / type all come from Schatten's
   * public tokens so the page re-themes with the token layer (dark mode
   * included) without any page-side logic. */
  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-4) var(--spacing-8);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__brand {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
  }

  .site-header__nav {
    display: flex;
    gap: var(--spacing-6);
  }

  .site-header__nav a {
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-header__nav a:hover {
    color: var(--color-foreground);
  }

  .site-header__lang {
    border-left: 1px solid var(--color-border);
    padding-left: var(--spacing-6);
  }

  /* ---- theme toggle ---- */
  .theme-toggle {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    color: var(--color-foreground-muted);
  }

  .theme-toggle:hover {
    color: var(--color-foreground);
  }

  .theme-toggle__icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Icon shows the DESTINATION mode: moon in light (click → dark), sun in
   * dark. "Effective dark" has two sources — the `.dark` class, or OS dark
   * with no explicit `.light` — so both need the swap. */
  .theme-toggle__icon--sun {
    display: none;
  }

  :global(html.dark) .theme-toggle__icon--moon {
    display: none;
  }

  :global(html.dark) .theme-toggle__icon--sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not(.light)) .theme-toggle__icon--moon {
      display: none;
    }

    :global(html:not(.light)) .theme-toggle__icon--sun {
      display: block;
    }
  }

  .page {
    flex: 1;
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--spacing-16) var(--spacing-8);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__title {
    margin: 0;
    /* Headings ride the DS serif stack (EB Garamond / Noto Serif JP) — the
     * same `--font-serif` the Text component's `st-text--serif` consumes.
     * Fonts are injected by <GoogleFonts serif /> in <head>. */
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight, 1.25);
    text-wrap: balance;
    /* Progressive enhancement (Chromium 119+): phrase-based JP wrapping so
     * カタカナ語 don't break mid-word. Falls back to normal wrapping. */
    word-break: auto-phrase;
  }

  .hero__lead {
    margin: 0;
    max-width: 44rem;
    color: var(--color-foreground-muted);
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .hero__actions .st-btn {
    text-decoration: none;
  }

  .hero__badges {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---- proof block ---- */
  .proof__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }

  .proof__pane {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .proof__caption {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-subtle);
  }

  .proof__code {
    margin: 0;
    padding: var(--spacing-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  .proof__render {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding-top: var(--spacing-2);
    border-top: 1px dashed var(--color-border);
  }

  .proof__footer {
    /* .st-card__footer is a flex actions row by contract; this footer is
     * prose, so restore block flow. */
    display: block;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .proof__content {
      grid-template-columns: 1fr;
    }
  }

  /* ---- seasonal strip ---- */
  .seasons {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .seasons__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
  }

  .seasons__lead {
    margin: 0;
    max-width: 44rem;
    color: var(--color-foreground-muted);
    line-height: 1.8;
  }

  .seasons__strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: var(--spacing-2);
  }

  .seasons__swatch {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-control);
    background: var(--swatch);
    display: flex;
    align-items: flex-end;
    padding: var(--spacing-2);
  }

  .seasons__swatch span {
    font-size: var(--text-xs);
    color: oklch(98% 0.005 70);
  }

  @media (max-width: 40rem) {
    .seasons__strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .site-footer {
    padding: var(--spacing-6) var(--spacing-8);
    border-top: 1px solid var(--color-border);
    color: var(--color-foreground-subtle);
    font-size: var(--text-sm);
  }
</style>
