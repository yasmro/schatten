{
  "name": "@yasmro/schatten",
  "version": "0.8.0",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "Design system with CSS variants and React components",
  "type": "module",
  "main": "./dist/components/index.cjs",
  "module": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/components/index.d.ts",
        "require": "./dist/components/index.d.cts"
      },
      "style": "./dist/schatten.css",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./schatten.css": "./dist/schatten.css",
    "./schatten.manifest.json": "./dist/schatten.manifest.json",
    "./css/*": "./dist/css/*.css",
    "./core/tokens": "./dist/core/tokens/index.css",
    "./themes/default": "./dist/themes/default/index.css",
    "./themes/seasonal": {
      "types": {
        "import": "./dist/themes/seasonal/index.d.ts",
        "require": "./dist/themes/seasonal/index.d.cts"
      },
      "import": "./dist/themes/seasonal/index.js",
      "require": "./dist/themes/seasonal/index.cjs"
    },
    "./themes/seasonal/themes.css": "./dist/themes/seasonal/themes.css",
    "./variants": {
      "types": {
        "import": "./dist/variants/index.d.ts",
        "require": "./dist/variants/index.d.cts"
      },
      "import": "./dist/variants/index.js",
      "require": "./dist/variants/index.cjs"
    },
    "./tokens": {
      "types": {
        "import": "./dist/tokens/index.d.ts",
        "require": "./dist/tokens/index.d.cts"
      },
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./components": {
      "types": {
        "import": "./dist/components/index.d.ts",
        "require": "./dist/components/index.d.cts"
      },
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./components/lv1": {
      "types": {
        "import": "./dist/components/lv1/index.d.ts",
        "require": "./dist/components/lv1/index.d.cts"
      },
      "import": "./dist/components/lv1/index.js",
      "require": "./dist/components/lv1/index.cjs"
    },
    "./providers": {
      "types": {
        "import": "./dist/providers/index.d.ts",
        "require": "./dist/providers/index.d.cts"
      },
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./theme-init": {
      "types": {
        "import": "./dist/theme-init/index.d.ts",
        "require": "./dist/theme-init/index.d.cts"
      },
      "import": "./dist/theme-init/index.js",
      "require": "./dist/theme-init/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm clean:dist && pnpm build:js && pnpm check:use-client && pnpm build:css && pnpm build:component-css && pnpm build:copy-css && pnpm build:manifest",
    "clean:dist": "rm -rf dist",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/entry.css -o dist/schatten.css --minify",
    "build:component-css": "node scripts/build-component-css.mjs",
    "build:copy-css": "node scripts/copy-css-assets.mjs",
    "build:manifest": "node scripts/generate-manifest.mjs",
    "update:manifest": "node scripts/generate-manifest.mjs --commit",
    "check:manifest": "node scripts/check-manifest-diff.mjs",
    "sync:readme": "node scripts/sync-readme-components.mjs",
    "check:readme": "node scripts/sync-readme-components.mjs --check",
    "check:use-client": "node scripts/check-use-client-banner.mjs",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "schatten:csp-hash": "node scripts/print-csp-hash.mjs",
    "check:layer-order": "node scripts/check-layer-order.mjs",
    "build:storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:vrt": "playwright test --grep-invert a11y",
    "test:vrt:update": "playwright test --grep-invert a11y --update-snapshots",
    "test:vrt:dist": "node scripts/ensure-dist.mjs && playwright test src/docs/CSSApiDist.vrt.spec.ts",
    "test:a11y": "playwright test --grep a11y",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "lint:pkg": "publint",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "check:theme-allowlist": "node scripts/check-theme-allowlist.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/ui": "^4.1.6",
    "jsdom": "29",
    "lefthook": "^2.1.4",
    "lucide-react": "^1.7.0",
    "postcss": "^8.5.10",
    "publint": "^0.3.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^12.1.0",
    "storybook": "10.4.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vite": "7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
